# Server-only signing secret. Never rename this to NEXT_PUBLIC_SESSION_SECRET.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional public analytics measurement ID. This is an identifier, not a secret.
# Leave blank to disable third-party analytics scripts.
NEXT_PUBLIC_ANALYTICS_ID=

# Replace with the real canonical production origin before deployment
SITE_URL=https://addis-eats.example.com
